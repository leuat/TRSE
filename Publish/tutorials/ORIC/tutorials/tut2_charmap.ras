program AlternateCharacterSet;
@use "system/screen"
@use "compression/compression"
var

	@export "resources/charmaps/charmap1.flf" "resources/charmaps/charmap1.bin" 256
	
	// Please note: the ORIC Atmos uses a 6x8 font, not 8x8!
	charmap: incbin("resources/charmaps/charmap1.bin") compressed;

	src, dst: ^byte;
	i:byte;

begin
	// decompress character set to ascii postion 64
	Compression::Decompress(#charmap, #Screen::charmap+64*8);
	Screen::PrintText("ABCDEFGHIJKLMNOPQRSTUVWXYZ", 5, 10, Screen::ink_yellow);
	loop();
end.