program GoodOldBitmapPlasma;

@use "system/screen"

var
	
	const width : byte = 40;
	const height : byte = 50;
	
	// some plasma variables
	xx,yy,d,val,c2x,  c2y,ax, ay : byte at $40;

	sin : array[256] of byte = buildsinetable(256);
	
	// data generated by resources/fjong/generate_data.fjo
	data: incbin("data/smooth_data.bin");

	// mini sine table
    siny : array[ height ] of byte; 
	sinx : array[ width ] of byte; 

	skip : byte = 0;
	tabSkip40 : array[4] of integer = (0,80,40,120);
	ptr : ^byte;
	

	const yStart:byte = 0;
	const yEnd:byte = height;
	const xStart:byte = 0;
	const xEnd:byte = width;



// Plasma procedure

procedure Plasma();
begin
	c2x:=ax;
	c2y:=ay;
	
	// Set up y-sine table
	for xx:=0 to height do begin 
		siny[xx]:=  sin[c2x] + sin[c2y];
		c2x:=c2x+2;
		c2y:=c2y+3;
	end;

	ax:=ax+2;
	ay:=ay-5;

	// Set up x-sine table
	for xx:=0 to width do begin 
		sinx[xx] := sin[c2x] + sin[c2y];
		c2x:=c2x+3;
		c2y:=c2y+7;

	end;
	
	ptr:=#Screen::ScreenHires + tabSkip40[skip];	
	// Uncomment for original code (slow)
/*	
	for yy:=yStart to yEnd do 
	begin
		val:=siny[yy];
		for xx:=xStart to xEnd do 
		begin
			d:=(sinx[xx] +val);
			ptr[xx]:=data[d];
		end;
		ptr+=width*4;
	end;
*/
	// optimized
	for yy:=yStart to yEnd offpage do 
	begin
		val:=siny[yy];
		asm("
			
			repeat 40
			
			ldx #[i]
			lda sinx,x
			adc val
			tax
			lda data,x
			ldy #[i]
			sta (ptr),y
			
			repend
		");	

		ptr+=width*4;
	end;
		

end;

procedure PrepareData();
begin
	for d:=0 to 0 do
	begin
		// straaange oric graphics. straaange oric. but oh so cute.
		data[d] := (data[d])&%00111111 + 64;
	end;
end;

begin
	PrepareData();
	Screen::SetScreenMode(0, Screen::screen_height, Screen::hires_mode_60hz);

	while (true) do 
	begin
		Plasma();
		skip+=1;
		// skip every 4nd line
		if (skip=4) then skip:=0;
		
	end;

end.