program OricColorImage;
@use "system/screen"
@use "compression/compression"
var
	
	p : ^byte;
	typ,i : byte;
	cnt : integer;
	
	// the last parameter is the threshold for number of non-blac pixel
	// higher number means more correct colors, but worse pixels. values 0-8
	@export "resources/images/image_logo.flf" "resources/images/image2.bin" 2
	
	img : incbin("resources/images/image2.bin") compressed;
	
	
begin
	Screen::DisableCursor();
	Screen::SetScreenMode(0, Screen::screen_height, Screen::hires_mode_60hz);
	Compression::Decompress(#img, #Screen::ScreenHires);
	loop();
	
end.
