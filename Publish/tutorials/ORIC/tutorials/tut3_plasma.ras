program GoodOldPlasma;
var
	
	const width : byte = 40;
	const height : byte = 28;
	
	// some plasma variables
	xx,yy,d,val,c2x,  c2y,ax, ay : byte at $40;
	colorP: ^byte; // same as "pointer" or "pointer of byte";	

	sin : array[256] of byte = buildsinetable(127);

 	const baseCharacter:byte = $68;
 	
	// mini sine table
    siny : array[ height ] of byte; 
	sinx : array[ width ] of byte; 

	// Lookup table for text and colors
	lookupDiv16 : array[256] of byte = buildtable("i/20 + 33");
	lookupDiv16_colors : array[256] of byte = buildtable("i/36+1");

	ptr : ^byte;

	const yStart:byte = 0;
	const yEnd:byte = 28;
	const xStart:byte = 0;
	const xEnd:byte = 40;



// Plasma procedure


procedure Plasma();
begin
	c2x:=ax;
	c2y:=ay;
	
	// Set up y-sine table
	for xx:=0 to height do begin 
		siny[xx]:=  sin[c2x] + sin[c2y];
		c2x:=c2x+4;
		c2y:=c2y+9;
	end;

	ax:=ax+2;
	ay:=ay-5;

	// Set up x-sine table
	for xx:=0 to width step 2 do begin 
		sinx[xx] := sin[c2x] + sin[c2y];
		c2x:=c2x+3*2;
		c2y:=c2y+7*2;

	end;
	
	ptr:=$BB80;	
	// Monochrome upper part
	for yy:=yStart to yEnd/2 offpage do 
	begin
		val:=siny[yy];
		for xx:=xStart to xEnd offpage do 
		begin
			d:=(sinx[xx] +val);
			ptr[xx]:=lookupDiv16[ d ];
		end;
		ptr+=width;
	end;
	
	
	// Color lower part
	for yy:=yEnd/2 to yEnd offpage do 
	begin
		val:=siny[yy];
		for xx:=xStart to xEnd step 2 offpage do 
		begin
			d:=(sinx[xx] +val);
			// Set the color attribute
			ptr[xx]:=lookupDiv16_colors[ d ];
			// .. and then the actual ascii
			ptr[xx+1]:=lookupDiv16[ d ];
		end;
		ptr+=width;
	end;

end;


begin

	while (true) do 
		Plasma();

end.