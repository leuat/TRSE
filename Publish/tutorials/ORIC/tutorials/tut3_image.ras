program OricMonochromeImage;
@use "system/screen"
@use "compression/compression"
var
	
	p : ^byte;
	i,j : byte;
	
	@export "resources/images/image1.flf" "resources/images/image1.bin" 256
	
	img : incbin("resources/images/image1.bin") compressed;

	
	
begin
	Screen::SetScreenMode(0, Screen::screen_height, Screen::hires_mode_60hz);
	Compression::Decompress(#img, #Screen::ScreenHires);
	loop();
	
end.
