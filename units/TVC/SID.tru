/* ---------------------------------------------------------------- Start: a hang-IT be (a kép aljához igazítva) */
procedure Start();
begin
	asm("	call	SdStartK");
end;


/* ---------------------------------------------------------------- Sync: vár a következő képkockára (50/s) */
procedure Sync();
begin
	asm("	call	SdWaitK");
end;


/* ---------------------------------------------------------------- Play: a zene léptetése (képkockánként hívandó) */
procedure Play();
begin
	asm("	call	SdStepK");
end;


/* ---------------------------------------------------------------- Stop: csend, a rendszer IT-je, a CRTC vissza */
procedure Stop();
begin
	asm("	call	SdStopK");
end;


end.
