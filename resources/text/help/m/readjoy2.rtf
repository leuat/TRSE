<h3>ReadJoy2( );</h3>

<h3>Description</h3>
<p>Read joystick in port 2.</p>
<p>
Populates three special variables called joy2, joy2last and joy2pressed (all lowercase). In joy2, bits 0 - 4
contain a 1 while a direction on the joystick or the fire button is held. joy2pressed sets a bit only on the
reading where that direction or button was first pressed, and joy2last holds the previous reading.</p>
<p>Use JOY_UP, JOY_LEFT, JOY_DOWN, JOY_RIGHT and JOY_FIRE constants to determine which direction or button.</p>

<h3>Example</h3>

<code>
program C64JoystickExample;
var  

   
begin
	
	definescreen();

	screenmemory := $0400;
	ClearScreen(WHITE, ^$D800 );

	
	while(true) do
	begin
		ClearScreen($20, ^$0400);
		
		readjoy2();

                if (joy2 & JOY_UP) then printstring("UP",0,2);
		screenmemory := screenmemory + 40;
                if (joy2 & JOY_DOWN) then printstring("DOWN",0,4);
		screenmemory := screenmemory + 40;
                if (joy2 & JOY_LEFT) then printstring("LEFT",0,4);
		screenmemory := screenmemory + 40;
                if (joy2 & JOY_RIGHT) then printstring("RIGHT",0,5);
		screenmemory := screenmemory + 40;
                if (joy2 & JOY_FIRE) then printstring("FIRE",0,4);
		screenmemory := screenmemory + 40;
		
		// the following will briefly appear because they are only true when a joystick direction or fire button is first pressed
                if (joy2pressed & JOY_UP) then printstring("UP FIRST PRESS",0,14);
		screenmemory := screenmemory + 40;
                if (joy2pressed & JOY_DOWN) then printstring("DOWN FIRST PRESS",0,16);
		screenmemory := screenmemory + 40;
                if (joy2pressed & JOY_LEFT) then printstring("LEFT FIRST PRESS",0,16);
		screenmemory := screenmemory + 40;
                if (joy2pressed & JOY_RIGHT) then printstring("RIGHT FIRST PRESS",0,17);
		screenmemory := screenmemory + 40;
                if (joy2pressed & JOY_FIRE) then printstring("FIRE FIRST PRESS",0,16);
		

		waitforraster(180);

	end;
end.

                
</code>
